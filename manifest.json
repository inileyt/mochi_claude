{
  "manifest_version": 3,
  "name": "Mochi – a tiny companion for Claude",
  "short_name": "Mochi",
  "version": "1.28.0",
  "description": "A tiny pixel companion. Lives beside your claude.ai chat (and ChatGPT / Gemini if you enable them). Runs entirely in your browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Show or hide Mochi on this page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "debugger",
    "contextMenus",
    "offscreen"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/config.js",
        "src/site.js",
        "src/sites/claude.js",
        "src/sites/chatgpt.js",
        "src/sites/gemini.js",
        "src/store.js",
        "src/i18n.js",
        "src/locales/en.js",
        "src/locales/de.js",
        "src/locales/es.js",
        "src/locales/fr.js",
        "src/locales/hy.js",
        "src/locales/it.js",
        "src/locales/ja.js",
        "src/locales/pt.js",
        "src/locales/ru.js",
        "src/locales/uk.js",
        "src/locales/zh.js",
        "src/sentiment.js",
        "src/art.js",
        "src/styles.js",
        "src/companion.js",
        "src/mood-engine.js",
        "src/chat-watcher.js",
        "src/vibes.js",
        "src/ui-scan.js",
        "src/scan-export.js",
        "src/panel.js",
        "src/menu.js",
        "src/outfits.js",
        "src/outfit-editor.js",
        "src/progress.js",
        "src/characters/mochi.js",
        "src/characters/cat.js",
        "src/characters/robot.js",
        "src/characters/ghost.js",
        "src/friends.js",
        "src/colors.js",
        "src/sound.js",
        "src/prompt-coach.js",
        "src/long-chat.js",
        "src/notify.js",
        "src/minigame.js",
        "src/library.js",
        "src/bookmarks.js",
        "src/chat-export.js",
        "src/focus.js",
        "src/explore.js",
        "src/easter-eggs.js",
        "src/changelog.js",
        "src/onboarding.js",
        "src/birthday.js",
        "src/birthday-party.js",
        "src/online.js",
        "src/picker.js",
        "src/pocket.js",
        "src/deep-scan/zip.js",
        "src/deep-scan/cdp.js",
        "src/deep-scan/deep-scan.js",
        "src/deep-scan/safety.js",
        "src/deep-scan/structure.js",
        "src/deep-scan/sheets.js",
        "src/deep-scan/shots.js",
        "src/deep-scan/geometry.js",
        "src/deep-scan/responsive.js",
        "src/deep-scan/scroll.js",
        "src/deep-scan/tokens.js",
        "src/deep-scan/components.js",
        "src/deep-scan/states.js",
        "src/deep-scan/clicks.js",
        "src/deep-scan/motion.js",
        "src/deep-scan/jsmotion.js",
        "src/deep-scan/media.js",
        "src/deep-scan/content.js",
        "src/deep-scan/output.js",
        "src/deep-scan/spec-md.js",
        "src/deep-scan/output-files.js",
        "src/deep-scan/results-view.js",
        "src/image-scan/colors.js",
        "src/image-scan/palette.js",
        "src/image-scan/target.js",
        "src/image-scan/prompt.js",
        "src/image-scan/scan.js",
        "src/image-scan/hover.js",
        "src/image-scan/card.js",
        "src/image-scan/ask-claude.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
