{
  "manifest_version": 3,
  "name": "Mochi – a tiny companion for Claude",
  "short_name": "Mochi",
  "version": "1.22.0",
  "description": "A tiny orange pixel-art companion beside your claude.ai chat. Scan any page's UI or pick one element (a button, a card) into an AI-ready prompt, DESIGN.md, CSS or Tailwind, keep it in Mochi's pocket and paste it into Claude. Runs entirely in your browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Show or hide Mochi on this page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/config.js",
        "src/store.js",
        "src/i18n.js",
        "src/locales/en.js",
        "src/locales/ru.js",
        "src/sentiment.js",
        "src/art.js",
        "src/styles.js",
        "src/companion.js",
        "src/mood-engine.js",
        "src/chat-watcher.js",
        "src/vibes.js",
        "src/ui-scan.js",
        "src/scan-export.js",
        "src/panel.js",
        "src/menu.js",
        "src/outfits.js",
        "src/outfit-editor.js",
        "src/progress.js",
        "src/characters/mochi.js",
        "src/characters/cat.js",
        "src/characters/robot.js",
        "src/characters/ghost.js",
        "src/friends.js",
        "src/colors.js",
        "src/sound.js",
        "src/prompt-coach.js",
        "src/long-chat.js",
        "src/notify.js",
        "src/minigame.js",
        "src/library.js",
        "src/bookmarks.js",
        "src/chat-export.js",
        "src/focus.js",
        "src/explore.js",
        "src/easter-eggs.js",
        "src/picker.js",
        "src/pocket.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
